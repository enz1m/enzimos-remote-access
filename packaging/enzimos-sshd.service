[Unit]
Description=enzimOS approved SSH and SFTP sharing
After=dbus.service network-online.target firewalld.service NetworkManager.service
Wants=network-online.target
Requires=dbus.service
# Each unit stops the other: the listener never runs without its firewall guard.
# firewalld is only ordered: with it stopped, SSH stays up and unfiltered.
BindsTo=enzimos-sshd-firewall.service

[Service]
Type=exec
ExecStartPre=/usr/lib/enzimos-remote/ssh-entry prepare
ExecStart=/usr/bin/sshd -D -e -f /etc/enzimos/remote/sshd_config
ExecStartPost=/usr/lib/enzimos-remote/ssh-entry verify
ExecStopPost=/usr/lib/enzimos-remote/ssh-entry release
KillMode=process
TimeoutStartSec=90s
TimeoutStopSec=15s
Restart=no
UMask=0077
CPUWeight=80
IOWeight=40
TasksMax=512
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
Also=enzimos-sshd-retry.timer
