+++ b/server/SharingArguments.h
@@ -0,0 +1,59 @@
+// SPDX-FileCopyrightText: 2026 enzUI contributors
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <arpa/inet.h>
+#include <charconv>
+#include <filesystem>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+namespace EnzimOS {
+inline bool protectedInvocation(int argc, char **argv) {
+    for (int i=1;i<argc;++i) {
+        const std::string_view value(argv[i]);
+        if (value.starts_with("--sharing-password-fd") || value.starts_with("-sharing-password-fd")) return true;
+    }
+    return false;
+}
+inline std::optional<int> canonicalNumber(std::string_view text,int minimum,int maximum) {
+    int result=0;auto parsed=std::from_chars(text.data(),text.data()+text.size(),result);
+    if (parsed.ec!=std::errc{} || parsed.ptr!=text.data()+text.size() || result<minimum || result>maximum || std::to_string(result)!=text) return std::nullopt;
+    return result;
+}
+inline bool certificatePath(std::string_view text) {
+    if (text.empty() || text.size()>4096) return false;
+    for (unsigned char c:text) if (c<32 || c==127) return false;
+    const std::filesystem::path path(text);
+    if (!path.is_absolute() || path.lexically_normal()!=path || path.filename().empty()) return false;
+    for (const auto &part:path) if (part=="." || part=="..") return false;
+    return true;
+}
+inline bool concreteAddress(std::string_view text) {
+    const std::string value(text);char rendered[INET6_ADDRSTRLEN]{};
+    in_addr v4{};
+    if (inet_pton(AF_INET,value.c_str(),&v4)==1) {
+        const auto bytes=ntohl(v4.s_addr);
+        return bytes!=0 && bytes!=0xffffffffU && (bytes&0xf0000000U)!=0xe0000000U && inet_ntop(AF_INET,&v4,rendered,sizeof(rendered)) && value==rendered;
+    }
+    in6_addr v6{};
+    if (inet_pton(AF_INET6,value.c_str(),&v6)!=1 || IN6_IS_ADDR_UNSPECIFIED(&v6) || IN6_IS_ADDR_MULTICAST(&v6) || IN6_IS_ADDR_V4MAPPED(&v6)) return false;
+    return inet_ntop(AF_INET6,&v6,rendered,sizeof(rendered)) && value==rendered;
+}
+inline bool protectedArguments(const std::vector<std::string_view> &args) {
+    if (args.size()<14 || args.size()>15) return false;
+    std::map<std::string_view,std::string_view> values;
+    bool view=false;
+    for (size_t i=0;i<args.size();++i) {
+        const auto name=args[i];
+        if (name=="--view-only") {if(view)return false;view=true;continue;}
+        if (name!="--sharing-password-fd" && name!="--listener-fd" && name!="--address" && name!="--port" && name!="--certificate" && name!="--certificate-key" && name!="--mode") return false;
+        if (++i>=args.size() || !values.emplace(name,args[i]).second) return false;
+    }
+    if(values.size()!=7) return false;
+    const auto credential=canonicalNumber(values["--sharing-password-fd"],3,1024);
+    const auto listener=canonicalNumber(values["--listener-fd"],3,1024);
+    return credential && listener && credential!=listener && canonicalNumber(values["--port"],1024,65535) && concreteAddress(values["--address"]) && certificatePath(values["--certificate"]) && certificatePath(values["--certificate-key"]) && values["--certificate"]!=values["--certificate-key"] && values["--mode"]=="SharedAccess";
+}
+}
