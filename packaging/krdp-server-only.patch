+
+namespace EnzimOS
+{
+namespace
+{
+void erase(char *bytes, size_t size)
+{
+    volatile char *cursor = bytes;
+    while (size-- > 0) {
+        *cursor++ = 0;
+    }
+}
+
+struct Descriptor {
+    int value;
+    ~Descriptor() { close(value); }
+};
+
+struct Buffer {
+    std::array<char, 128> bytes{};
+    ~Buffer() { erase(bytes.data(), bytes.size()); }
+};
+
+bool tokenCharacter(unsigned char value)
+{
+    return (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') || (value >= '0' && value <= '9') || value == '_' || value == '-';
+}
+}
+
+SharingPassword::~SharingPassword()
+{
+    erase(m_value.data(), m_value.size());
+}
+
+bool protectSharingCredentials()
+{
+    const rlimit limit{0, 0};
+    return setrlimit(RLIMIT_CORE, &limit) == 0 && prctl(PR_SET_DUMPABLE, 0) == 0
+        && close_range(3, 1024, CLOSE_RANGE_CLOEXEC) == 0;
+}
+
+std::optional<SharingPassword> readSharingPassword(int ownedFd)
+{
+    if (ownedFd < 3 || ownedFd > 1024) {
+        return std::nullopt;
+    }
+    const Descriptor descriptor{ownedFd};
+    constexpr int seals = F_SEAL_SEAL | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_WRITE;
+    struct stat before{};
+    if (fstat(ownedFd, &before) != 0 || !S_ISREG(before.st_mode) || before.st_uid != getuid() || before.st_nlink != 0
+        || (before.st_mode & 0777) != 0600 || before.st_size < 32 || before.st_size > 128) {
+        return std::nullopt;
+    }
+    const int actualSeals = fcntl(ownedFd, F_GET_SEALS);
+    if (actualSeals < 0 || (actualSeals & seals) != seals) {
+        return std::nullopt;
+    }
+    Buffer buffer;
+    size_t used = 0;
+    const size_t size = static_cast<size_t>(before.st_size);
+    while (used < size) {
+        const ssize_t count = pread(ownedFd, buffer.bytes.data() + used, size - used, static_cast<off_t>(used));
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            return std::nullopt;
+        }
+        used += static_cast<size_t>(count);
+    }
+    for (size_t i = 0; i < size; ++i) {
+        if (!tokenCharacter(static_cast<unsigned char>(buffer.bytes[i]))) {
+            return std::nullopt;
+        }
+    }
+    struct stat after{};
+    if (fstat(ownedFd, &after) != 0 || before.st_dev != after.st_dev || before.st_ino != after.st_ino || before.st_size != after.st_size
+        || before.st_uid != after.st_uid || before.st_mode != after.st_mode || before.st_nlink != after.st_nlink) {
+        return std::nullopt;
+    }
+    return SharingPassword(std::string(buffer.bytes.data(), size));
+}
+}
diff --git a/server/SharingPassword.h b/server/SharingPassword.h
new file mode 100644
index 0000000..df02a13
--- /dev/null
+++ b/server/SharingPassword.h
@@ -0,0 +1,34 @@
+// SPDX-FileCopyrightText: 2026 enzUI contributors
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <optional>
+#include <string>
+#include <utility>
+
+namespace EnzimOS
+{
+class SharingPassword
+{
+public:
+    explicit SharingPassword(std::string value)
+        : m_value(std::move(value))
+    {
+    }
+    SharingPassword(const SharingPassword &) = delete;
+    SharingPassword &operator=(const SharingPassword &) = delete;
+    SharingPassword(SharingPassword &&other) noexcept
+        : m_value(std::move(other.m_value))
+    {
+    }
+    ~SharingPassword();
+    const std::string &value() const { return m_value; }
+
+private:
+    std::string m_value;
+};
+
+bool protectSharingCredentials();
+// Consumes an inherited descriptor in [3, 1024]; the sender's descriptor is separate.
+std::optional<SharingPassword> readSharingPassword(int ownedFd);
+}
