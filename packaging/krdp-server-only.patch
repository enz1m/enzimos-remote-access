new file mode 100644
index 0000000..d74539c
--- /dev/null
+++ b/server/SharingPasswordTest.cpp
@@ -0,0 +1,130 @@
+// SPDX-FileCopyrightText: 2026 enzUI contributors
+// SPDX-License-Identifier: MIT
+#include "SharingPassword.h"
+#include "SharingArguments.h"
+
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <fcntl.h>
+#include <iostream>
+#include <string>
+#include <sys/mman.h>
+#include <sys/prctl.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+namespace
+{
+constexpr int allSeals = F_SEAL_SEAL | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_WRITE;
+void require(bool value, const char *message)
+{
+    if (!value) {
+        std::cerr << message << '\n';
+        std::exit(1);
+    }
+}
+
+int input(const std::string &text, int seals = allSeals, mode_t mode = 0600)
+{
+    int fd = memfd_create("rdp-test-credential", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+    require(fd >= 3, "memfd creation failed");
+    require(fchmod(fd, mode) == 0, "mode setup failed");
+    require(write(fd, text.data(), text.size()) == static_cast<ssize_t>(text.size()), "fixture write failed");
+    require(fcntl(fd, F_ADD_SEALS, seals) == 0, "sealing failed");
+    return fd;
+}
+
+void refused(int ownedFd)
+{
+    require(!EnzimOS::readSharingPassword(ownedFd).has_value(), "invalid credential accepted");
+    errno = 0;
+    require(fcntl(ownedFd, F_GETFD) == -1 && errno == EBADF, "owned rejected descriptor leaked");
+}
+}
+
+int main(int argc, char **argv)
+{
+    if (argc == 3 && std::string(argv[1]) == "--closed-fd") {
+        errno = 0;
+        return fcntl(std::atoi(argv[2]), F_GETFD) == -1 && errno == EBADF ? 0 : 1;
+    }
+    const std::vector<std::string_view> valid = {"--sharing-password-fd","63","--listener-fd","64","--address","127.0.0.1","--port","3389","--certificate","/home/user/server.crt","--certificate-key","/home/user/server.key","--mode","SharedAccess"};
+    require(EnzimOS::protectedArguments(valid), "closed protected arguments refused");
+    auto view = valid; view.push_back("--view-only");
+    require(EnzimOS::protectedArguments(view), "protected view-only refused");
+    for (const auto &[index,bad] : std::vector<std::pair<size_t,std::string_view>>{{1,"063"},{1,"+63"},{3,"63"},{5,"0.0.0.0"},{5,"224.0.0.1"},{5,"255.255.255.255"},{5,"::"},{5,"ff02::1"},{7,"0"},{7,"65536"},{7,"03389"},{9,"relative.crt"},{9,"/home/../user/server.crt"},{11,"/home/user/server.crt"},{13,"RemoteAccess"}}) {
+        auto malformed = valid; malformed[index] = bad;
+        require(!EnzimOS::protectedArguments(malformed), "invalid protected arguments accepted");
+    }
+    auto plugin = valid; plugin.insert(plugin.begin(),{"-platformpluginpath","/tmp/plugin"});
+    require(!EnzimOS::protectedArguments(plugin), "Qt plugin injection accepted");
+    auto missing = valid; missing.erase(missing.begin()+2,missing.begin()+4);
+    require(!EnzimOS::protectedArguments(missing), "protected bind fallback accepted");
+    auto duplicate = view; duplicate.push_back("--view-only");
+    require(!EnzimOS::protectedArguments(duplicate), "duplicate flag accepted");
+    int inherited = input(std::string(32, 'A'));
+    require(fcntl(inherited, F_SETFD, 0) == 0, "inherited descriptor setup failed");
+    require(EnzimOS::protectSharingCredentials(), "process privacy setup failed");
+    require((fcntl(inherited, F_GETFD) & FD_CLOEXEC) != 0, "credential can escape into an exec child");
+    pid_t child = fork();
+    require(child >= 0, "exec fixture fork failed");
+    if (child == 0) {
+        const std::string number = std::to_string(inherited);
+        execl("/proc/self/exe", argv[0], "--closed-fd", number.c_str(), static_cast<char *>(nullptr));
+        _exit(127);
+    }
+    int status = 0;
+    require(waitpid(child, &status, 0) == child && WIFEXITED(status) && WEXITSTATUS(status) == 0, "credential survived child exec");
+    require(fcntl(inherited, F_GETFD) >= 0, "parent credential closed by privacy setup");
+    close(inherited);
+    rlimit limit{};
+    require(getrlimit(RLIMIT_CORE, &limit) == 0 && limit.rlim_cur == 0 && limit.rlim_max == 0, "core limit missing");
+    require(prctl(PR_GET_DUMPABLE) == 0, "process is dumpable");
+    for (size_t size : {32u, 128u}) {
+        std::string expected(size, 'A');
+        expected.replace(0, 8, "aZ09_-bc");
+        int parent = input(expected);
+        require(lseek(parent, 7, SEEK_SET) == 7, "offset setup failed");
+        int child = fcntl(parent, F_DUPFD_CLOEXEC, 3);
+        require(child >= 3, "descriptor duplication failed");
+        auto value = EnzimOS::readSharingPassword(child);
+        require(value.has_value() && value->value() == expected, "sealed credential changed");
+        require(fcntl(child, F_GETFD) == -1 && errno == EBADF, "consumed descriptor leaked");
+        require(lseek(parent, 0, SEEK_CUR) == 7, "sender offset changed");
+        char first = 0;
+        require(pread(parent, &first, 1, 0) == 1 && first == expected[0], "sender descriptor lost");
+        require(pwrite(parent, "X", 1, 0) == -1 && errno == EPERM, "sealed write accepted");
+        close(parent);
+    }
+    for (int missing : {F_SEAL_SEAL, F_SEAL_GROW, F_SEAL_SHRINK, F_SEAL_WRITE}) {
+        refused(input(std::string(32, 'A'), allSeals & ~missing));
+    }
+    for (size_t size : {0u, 31u, 129u}) {
+        refused(input(std::string(size, 'A')));
+    }
+    for (mode_t mode : {0400u, 0640u, 0604u, 0700u}) {
+        refused(input(std::string(32, 'A'), allSeals, mode));
+    }
+    for (char invalid : {'\0', '\n', '\r', ' ', '=', static_cast<char>(0xff)}) {
+        std::string text(32, 'A');
+        text[15] = invalid;
+        refused(input(text));
+    }
+    int pipeFds[2];
+    require(pipe2(pipeFds, O_CLOEXEC) == 0, "pipe fixture failed");
+    refused(pipeFds[0]);
+    close(pipeFds[1]);
+    FILE *file = tmpfile();
+    require(file != nullptr, "ordinary file fixture failed");
+    require(fwrite(std::string(32, 'A').data(), 1, 32, file) == 32 && fflush(file) == 0, "ordinary file write failed");
+    int copy = fcntl(fileno(file), F_DUPFD_CLOEXEC, 3);
+    require(copy >= 3, "ordinary file duplication failed");
+    refused(copy);
+    fclose(file);
+    require(!EnzimOS::readSharingPassword(-1) && !EnzimOS::readSharingPassword(1), "reserved descriptor accepted");
+    require(fcntl(1, F_GETFD) != -1, "stdout closed by invalid input");
+    std::cout << "sealed input, size/syntax/mode refusals, descriptor lifetime and process privacy passed\n";
+}
