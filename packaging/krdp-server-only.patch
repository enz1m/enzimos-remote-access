new file mode 100644
index 0000000..8abfa36
--- /dev/null
+++ b/src/InheritedListener.h
@@ -0,0 +1,77 @@
+// SPDX-FileCopyrightText: 2026 enzUI contributors
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <array>
+#include <cstring>
+#include <utility>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <QHostAddress>
+#include <QNetworkProxy>
+#include <QTcpServer>
+
+namespace EnzimOS
+{
+inline bool listenerMatches(int fd, const QHostAddress &address, quint16 port)
+{
+    if (fd < 3 || fd > 1024 || port < 1024 || address.isNull() || address.isMulticast()
+        || address == QHostAddress::Any || address == QHostAddress::AnyIPv4 || address == QHostAddress::AnyIPv6) {
+        return false;
+    }
+    struct stat info{};
+    if (fstat(fd, &info) != 0 || !S_ISSOCK(info.st_mode) || (info.st_uid != 0 && info.st_uid != getuid())) {
+        return false;
+    }
+    const std::array<std::pair<int, int>, 5> options{{{SO_TYPE, SOCK_STREAM}, {SO_PROTOCOL, IPPROTO_TCP}, {SO_ACCEPTCONN, 1}, {SO_REUSEPORT, 0}, {SO_REUSEADDR, 0}}};
+    for (const auto &[option, expected] : options) {
+        int value = -1;
+        socklen_t length = sizeof(value);
+        if (getsockopt(fd, SOL_SOCKET, option, &value, &length) != 0 || length != sizeof(value) || value != expected) {
+            return false;
+        }
+    }
+    sockaddr_storage local{};
+    socklen_t size = sizeof(local);
+    if (getsockname(fd, reinterpret_cast<sockaddr *>(&local), &size) != 0) {
+        return false;
+    }
+    if (local.ss_family == AF_INET && size == sizeof(sockaddr_in) && address.protocol() == QAbstractSocket::IPv4Protocol) {
+        const auto &endpoint = reinterpret_cast<const sockaddr_in &>(local);
+        return ntohs(endpoint.sin_port) == port && ntohl(endpoint.sin_addr.s_addr) == address.toIPv4Address();
+    }
+    if (local.ss_family == AF_INET6 && size == sizeof(sockaddr_in6) && address.protocol() == QAbstractSocket::IPv6Protocol) {
+        const auto &endpoint = reinterpret_cast<const sockaddr_in6 &>(local);
+        int only = 0;
+        socklen_t length = sizeof(only);
+        const auto expected = address.toIPv6Address();
+        return endpoint.sin6_scope_id == 0 && ntohs(endpoint.sin6_port) == port
+            && std::memcmp(endpoint.sin6_addr.s6_addr, expected.c, sizeof(expected.c)) == 0
+            && getsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, &only, &length) == 0 && length == sizeof(only) && only == 1;
+    }
+    return false;
+}
+
+// Qt owns only a duplicate; the upstream reservation survives provider teardown.
+inline bool adoptListener(QTcpServer &server, int fd, const QHostAddress &address, quint16 port)
+{
+    if (server.isListening() || !listenerMatches(fd, address, port)) {
+        return false;
+    }
+    const int copy = fcntl(fd, F_DUPFD_CLOEXEC, 3);
+    if (copy < 0) {
+        return false;
+    }
+    server.setProxy(QNetworkProxy::NoProxy);
+    if (!server.setSocketDescriptor(copy)) {
+        server.close();
+        close(copy);
+        return false;
+    }
+    return true;
+}
+}
