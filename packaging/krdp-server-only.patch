new file mode 100644
index 0000000..d20d450
--- /dev/null
+++ b/server/InputAdmissionTest.cpp
@@ -0,0 +1,97 @@
+// SPDX-FileCopyrightText: 2026 enzUI contributors
+// SPDX-License-Identifier: MIT
+#include "../src/InputHandler.h"
+#include "../src/PeerContext_p.h"
+#include "../src/AbstractSession.h"
+
+#include <cstdlib>
+#include <iostream>
+#include <vector>
+
+#include <QCoreApplication>
+#include <QEvent>
+#include <QThread>
+#include <QClipboard>
+#include <QGuiApplication>
+#include <QMimeData>
+#include <KSystemClipboard>
+
+namespace
+{
+void require(bool value, const char *message)
+{
+    if (!value) {
+        std::cerr << message << '\n';
+        std::exit(1);
+    }
+}
+
+class ClipboardProbe : public KRdp::AbstractSession
+{
+public:
+    ClipboardProbe(bool enabled) : AbstractSession(enabled) {}
+    void start() override {}
+    void sendEvent(const std::shared_ptr<QEvent> &) override {}
+};
+
+void clipboardAdmission()
+{
+    ClipboardProbe enabled(true),disabled(false);int observed=0,suppressed=0;
+    QObject::connect(&enabled,&KRdp::AbstractSession::clipboardDataChanged,&enabled,[&](const QMimeData *data) {++observed;delete data;});
+    QObject::connect(&disabled,&KRdp::AbstractSession::clipboardDataChanged,&disabled,[&](const QMimeData *data) {++suppressed;delete data;});
+    auto baseline=new QMimeData;baseline->setText(QStringLiteral("baseline"));KSystemClipboard::instance()->setMimeData(baseline,QClipboard::Clipboard);
+    const auto before=QGuiApplication::clipboard()->text();
+    auto rejected=std::make_unique<QMimeData>();rejected->setText(QStringLiteral("forbidden"));disabled.setClipboardData(std::move(rejected));
+    require(QGuiApplication::clipboard()->text()==before,"disabled clipboard accepted remote write");
+    QMetaObject::invokeMethod(KSystemClipboard::instance(),"changed",Qt::DirectConnection,Q_ARG(QClipboard::Mode,QClipboard::Clipboard));
+    require(observed>0 && suppressed==0,"clipboard positive observation missing or disabled observer received update");
+    auto permitted=std::make_unique<QMimeData>();permitted->setText(QStringLiteral("positive"));enabled.setClipboardData(std::move(permitted));
+    require(QGuiApplication::clipboard()->text()==QStringLiteral("positive"),"enabled clipboard positive write failed");
+}
+
+void stimulus(rdpInput &input)
+{
+    require(input.MouseEvent(&input, PTR_FLAGS_MOVE, 20, 30), "mouse callback failed");
+    require(input.ExtendedMouseEvent(&input, PTR_XFLAGS_BUTTON1 | PTR_XFLAGS_DOWN, 20, 30), "extended callback failed");
+    require(input.KeyboardEvent(&input, KBD_FLAGS_DOWN, 30), "key callback failed");
+    require(input.UnicodeKeyboardEvent(&input, KBD_FLAGS_DOWN, 'A'), "unicode callback failed");
+    require(input.SynchronizeEvent(&input, 0), "synchronize callback failed");
+}
+}
+
+int main(int argc, char **argv)
+{
+    QGuiApplication application(argc, argv);
+    clipboardAdmission();
+    KRdp::InputHandler handler(nullptr);
+    KRdp::PeerContext context{};
+    context.inputHandler = &handler;
+    rdpInput input{};
+    input.context = &context._p;
+    std::vector<QEvent::Type> events;
+    QObject receiver;
+    QObject::connect(&handler, &KRdp::InputHandler::inputEvent, &receiver, [&events](std::shared_ptr<QInputEvent> event) {
+        events.push_back(event->type());
+    }, Qt::DirectConnection);
+    QThread worker;
+    handler.moveToThread(&worker);worker.start();
+    QMetaObject::invokeMethod(&handler, [&]() { handler.initialize(&input); }, Qt::BlockingQueuedConnection);
+    stimulus(input);
+    require(events.empty(), "unapproved default input emitted events");
+    QMetaObject::invokeMethod(&handler, [&]() { handler.setEnabled(true); }, Qt::BlockingQueuedConnection);
+    stimulus(input);
+    require(events.size() == 5 && events[0] == QEvent::MouseMove && events[1] == QEvent::MouseButtonPress
+        && events[2] == QEvent::KeyPress && events[3] == QEvent::KeyPress && events[4] == QEvent::KeyRelease, "enabled input control did not emit all event kinds");
+    require(input.KeyboardEvent(&input, KBD_FLAGS_DOWN, 30), "held-key setup failed");
+    const size_t beforeDisable = events.size();
+    QMetaObject::invokeMethod(&handler, [&]() { handler.setEnabled(false); }, Qt::BlockingQueuedConnection);
+    require(events.size() == beforeDisable + 1 && events.back() == QEvent::KeyRelease, "disabling input left a held key");
+    const size_t blocked = events.size();
+    stimulus(input);
+    require(events.size() == blocked, "view-only input emitted events");
+    QMetaObject::invokeMethod(&handler, [&]() { handler.setEnabled(true); }, Qt::BlockingQueuedConnection);
+    require(input.SynchronizeEvent(&input, 0) && events.size() == blocked, "blocked input mutated held-key state");
+    QMetaObject::invokeMethod(&handler, [&]() { handler.moveToThread(application.thread()); }, Qt::BlockingQueuedConnection);
+    worker.quit();require(worker.wait(5000), "input worker did not terminate");
+    std::cout << "real FreeRDP callbacks: default/view-only suppression, all positive event kinds and held-key release passed\n";
+}
diff --git a/server/MemorySamFileTest.cpp b/server/MemorySamFileTest.cpp
new file mode 100644
index 0000000..2c1a55f
--- /dev/null
+++ b/server/MemorySamFileTest.cpp
@@ -0,0 +1,60 @@
+// SPDX-FileCopyrightText: 2026 enzUI contributors
+// SPDX-License-Identifier: MIT
+#include "../src/MemorySamFile.h"
+
+#include <array>
+#include <cstdlib>
+#include <iostream>
+#include <winpr/sam.h>
+
+namespace
+{
+void require(bool value, const char *message)
+{
+    if (!value) {
+        std::cerr << message << '\n';
+        std::exit(1);
+    }
+}
+}
+
+int main()
+{
+    constexpr auto payload = "enzimos:::000102030405060708090a0b0c0d0e0f:::\n";
+    std::string name;
+    {
+        EnzimOS::MemorySamFile file;
+        require(!file.store("") && file.path().empty(), "empty SAM accepted");
+        require(file.store(payload), "anonymous SAM creation failed");
+        name = file.path();
+        require(name.starts_with("/proc/self/fd/"), "SAM has a named filesystem path");
+        require(!file.store(payload), "live SAM replaced");
+        int reader = open(name.c_str(), O_RDONLY | O_CLOEXEC);
+        require(reader >= 0, "proc-fd SAM cannot be opened");
+        struct stat info{};
+        require(fstat(reader, &info) == 0 && info.st_nlink == 0 && (info.st_mode & 0777) == 0600, "SAM metadata invalid");
+        constexpr int seals = F_SEAL_SEAL | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_WRITE;
+        const int actualSeals = fcntl(reader, F_GET_SEALS);
+        require(actualSeals >= 0 && (actualSeals & seals) == seals, "SAM seals missing");
+        close(reader);
+        int writer = open(name.c_str(), O_RDWR | O_CLOEXEC);
+        require(writer >= 0, "sealed SAM writer probe failed to open");
+        require(pwrite(writer, "X", 1, 0) == -1 && errno == EPERM, "SAM changed after sealing");
+        close(writer);
+        for (int attempt = 0; attempt < 2; ++attempt) {
+            WINPR_SAM *sam = SamOpen(name.c_str(), TRUE);
+            require(sam != nullptr, "WinPR rejected anonymous SAM path");
+            WINPR_SAM_ENTRY *entry = SamLookupUserA(sam, "enzimos", 7, "", 0);
+            require(entry != nullptr, "WinPR did not find configured sharing identity");
+            for (size_t i = 0; i < 16; ++i) {
+                require(entry->NtHash[i] == i, "WinPR read a different credential hash");
+            }
+            SamFreeEntry(sam, entry);
+            entry = SamLookupUserA(sam, "other", 5, "", 0);
+            require(entry == nullptr, "WinPR accepted another identity");
+            SamClose(sam);
+        }
+    }
+    require(open(name.c_str(), O_RDONLY | O_CLOEXEC) == -1 && errno == ENOENT, "SAM survived its owner");
+    std::cout << "anonymous sealed SAM, real WinPR lookup and teardown passed\n";
+}
