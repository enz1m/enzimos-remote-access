diff --git a/src/MemorySamFile.h b/src/MemorySamFile.h
new file mode 100644
index 0000000..d4eaa76
--- /dev/null
+++ b/src/MemorySamFile.h
@@ -0,0 +1,63 @@
+// SPDX-FileCopyrightText: 2026 enzUI contributors
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <cerrno>
+#include <fcntl.h>
+#include <string>
+#include <string_view>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace EnzimOS
+{
+class MemorySamFile
+{
+public:
+    MemorySamFile() = default;
+    MemorySamFile(const MemorySamFile &) = delete;
+    MemorySamFile &operator=(const MemorySamFile &) = delete;
+    ~MemorySamFile()
+    {
+        if (m_fd >= 0) {
+            close(m_fd);
+        }
+    }
+
+    bool store(std::string_view bytes)
+    {
+        if (m_fd >= 0 || bytes.empty() || bytes.size() > 1024 * 1024) {
+            return false;
+        }
+        m_fd = memfd_create("enzimos-rdp-sam", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+        if (m_fd < 0 || fchmod(m_fd, 0600) != 0) {
+            return false;
+        }
+        size_t offset = 0;
+        while (offset < bytes.size()) {
+            const ssize_t count = write(m_fd, bytes.data() + offset, bytes.size() - offset);
+            if (count < 0 && errno == EINTR) {
+                continue;
+            }
+            if (count <= 0) {
+                return false;
+            }
+            offset += static_cast<size_t>(count);
+        }
+        constexpr int seals = F_SEAL_SEAL | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_WRITE;
+        if (fcntl(m_fd, F_ADD_SEALS, seals) != 0) {
+            return false;
+        }
+        m_path = "/proc/self/fd/" + std::to_string(m_fd);
+        return true;
+    }
+
+    // Retain through peer teardown: an early close could recycle this proc-fd path.
+    const std::string &path() const { return m_path; }
+
+private:
+    int m_fd = -1;
+    std::string m_path;
+};
+}
