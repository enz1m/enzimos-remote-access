diff --git a/server/EisInputTest.cpp b/server/EisInputTest.cpp
new file mode 100644
index 0000000..9414eef
--- /dev/null
+++ b/server/EisInputTest.cpp
@@ -0,0 +1,127 @@
+// SPDX-FileCopyrightText: 2026 enzUI contributors
+// SPDX-License-Identifier: MIT
+#include "../src/EiConnection.h"
+
+#include <QCoreApplication>
+#include <QElapsedTimer>
+#include <QKeyEvent>
+#include <QMouseEvent>
+#include <QPointer>
+#include <QThread>
+#include <libeis.h>
+#include <cstdlib>
+#include <iostream>
+#include <memory>
+#include <unistd.h>
+#include <fcntl.h>
+
+namespace
+{
+void require(bool value,const char *message)
+{
+    if (!value) {std::cerr << message << '\n';std::exit(1);}
+}
+
+void dispatch(eis *server,int &keyEvents,eis_client *&accepted,eis_device *&keyboard,bool &allowResume)
+{
+    eis_dispatch(server);
+    while (auto event=eis_get_event(server)) {
+        const auto type=eis_event_get_type(event);
+        if (type==EIS_EVENT_CLIENT_CONNECT) {
+            auto client=eis_event_get_client(event);require(eis_client_is_sender(client),"non-sender client");
+            require(accepted==nullptr,"unexpected second client");accepted=eis_client_ref(client);eis_client_connect(client);
+            auto seat=eis_client_new_seat(client,"private-fixture");eis_seat_configure_capability(seat,EIS_DEVICE_CAP_KEYBOARD);eis_seat_add(seat);eis_seat_unref(seat);
+        } else if (type==EIS_EVENT_SEAT_BIND) {
+            auto seat=eis_event_get_seat(event);
+            if (eis_seat_has_capability(seat,EIS_DEVICE_CAP_KEYBOARD)) {
+                if (!keyboard) {
+                    keyboard=eis_seat_new_device(seat);eis_device_configure_name(keyboard,"private-keyboard");eis_device_configure_capability(keyboard,EIS_DEVICE_CAP_KEYBOARD);eis_device_add(keyboard);
+                }
+            }
+        } else if (type==EIS_EVENT_DEVICE_READY) {
+            if (allowResume) eis_device_resume(eis_event_get_device(event));
+        } else if (type==EIS_EVENT_DEVICE_CLOSED) {
+            if (keyboard) {eis_device_unref(keyboard);keyboard=nullptr;}
+        } else if (type==EIS_EVENT_KEYBOARD_KEY) {
+            require(eis_event_keyboard_get_key(event)==30,"different key transmitted");++keyEvents;
+        }
+        eis_event_unref(event);
+    }
+}
+
+void callbackLifetime(QCoreApplication &application,bool destroyOnConnect)
+{
+    auto server=eis_new(nullptr);require(server!=nullptr,"callback EIS context failed");
+    eis_set_flag(server,EIS_FLAG_DEVICE_READY);require(eis_setup_backend_fd(server)==0,"callback EIS backend failed");
+    int fd=eis_backend_fd_add_client(server);require(fd>=0,"callback EIS client failed");
+    int keys=0,connections=0,errors=0;bool resume=false;eis_client *accepted=nullptr;eis_device *keyboard=nullptr;
+    auto sender=std::make_unique<KRdp::EiConnection>(fd);QPointer<KRdp::EiConnection> alive(sender.get());
+    QObject::connect(sender.get(),&KRdp::EiConnection::connected,&application,[&]() {++connections;if (destroyOnConnect) sender.reset();});
+    QObject::connect(sender.get(),&KRdp::EiConnection::error,&application,[&]() {++errors;sender.reset();});
+    QElapsedTimer deadline;deadline.start();
+    while (connections==0 && deadline.elapsed()<3000) {dispatch(server,keys,accepted,keyboard,resume);application.processEvents();QThread::msleep(1);}
+    require(connections==1,"callback handshake receipt missing");
+    if (!destroyOnConnect) {
+        require(accepted!=nullptr,"callback accepted client missing");eis_client_disconnect(accepted);
+        deadline.restart();while (errors==0 && deadline.elapsed()<3000) {dispatch(server,keys,accepted,keyboard,resume);application.processEvents();QThread::msleep(1);}
+        require(errors==1,"disconnect callback did not finish once");
+    }
+    require(alive.isNull(),"signal callback did not destroy EIS sender safely");
+    if (keyboard) eis_device_unref(keyboard);
+    if (accepted) eis_client_unref(accepted);
+    eis_unref(server);
+}
+}
+
+int main(int argc,char **argv)
+{
+    QCoreApplication application(argc,argv);
+    int sentinel=open("/dev/null",O_RDONLY|O_CLOEXEC);require(sentinel>=0,"sentinel open failed");
+    {KRdp::EiConnection invalid(-1);require(!invalid.isValid(),"invalid backend descriptor accepted");}
+    require(fcntl(sentinel,F_GETFD)>=0,"invalid EIS setup closed unrelated descriptor");close(sentinel);
+    callbackLifetime(application,true);callbackLifetime(application,false);
+    auto server=eis_new(nullptr);require(server!=nullptr,"private EIS context failed");
+    eis_set_flag(server,EIS_FLAG_DEVICE_READY);
+    require(eis_setup_backend_fd(server)==0,"private EIS FD backend failed");
+    int fd=eis_backend_fd_add_client(server);require(fd>=0,"private EIS client failed");
+    int keys=0,errors=0;int connections=0;bool allowResume=false;eis_client *accepted=nullptr;eis_device *keyboard=nullptr;
+    {
+        KRdp::EiConnection sender(fd,nullptr);require(sender.isValid(),"libei sender setup failed");
+        require(!sender.isConnected(),"unacknowledged libei context reported connected");
+        QObject::connect(&sender,&KRdp::EiConnection::connected,&application,[&]() {++connections;});
+        QObject::connect(&sender,&KRdp::EiConnection::error,&application,[&]() {++errors;});
+        QElapsedTimer elapsed;elapsed.start();
+        while (elapsed.elapsed()<300) {dispatch(server,keys,accepted,keyboard,allowResume);application.processEvents();QThread::msleep(1);}
+        auto press=std::make_shared<QKeyEvent>(QEvent::KeyPress,0,Qt::NoModifier,30,0,0);
+        auto release=std::make_shared<QKeyEvent>(QEvent::KeyRelease,0,Qt::NoModifier,30,0,0);
+        sender.sendEvent(press,QSize(1920,1080),QStringLiteral("fixture"));sender.sendEvent(release,QSize(1920,1080),QStringLiteral("fixture"));
+        elapsed.restart();while (elapsed.elapsed()<50) {dispatch(server,keys,accepted,keyboard,allowResume);application.processEvents();QThread::msleep(1);}
+        require(keys==0 && keyboard!=nullptr,"input sent before device resumed");
+        allowResume=true;eis_device_resume(keyboard);
+        elapsed.restart();while (elapsed.elapsed()<50) {dispatch(server,keys,accepted,keyboard,allowResume);application.processEvents();QThread::msleep(1);}
+        sender.sendEvent(std::make_shared<QMouseEvent>(QEvent::MouseMove,QPointF(20,30),QPointF(20,30),Qt::NoButton,Qt::NoButton,Qt::NoModifier),QSize(1920,1080),QString());
+        sender.sendEvent(press,QSize(1920,1080),QStringLiteral("fixture"));sender.sendEvent(release,QSize(1920,1080),QStringLiteral("fixture"));
+        elapsed.restart();while (keys<2 && elapsed.elapsed()<3000) {dispatch(server,keys,accepted,keyboard,allowResume);application.processEvents();QThread::msleep(1);}
+        require(keys==2 && errors==0 && connections==1 && sender.isConnected(),"real private EIS keyboard events/connection receipt missing");
+        eis_device_pause(keyboard);
+        elapsed.restart();while (elapsed.elapsed()<50) {dispatch(server,keys,accepted,keyboard,allowResume);application.processEvents();QThread::msleep(1);}
+        sender.sendEvent(press,QSize(1920,1080),QStringLiteral("fixture"));sender.sendEvent(release,QSize(1920,1080),QStringLiteral("fixture"));
+        elapsed.restart();while (elapsed.elapsed()<50) {dispatch(server,keys,accepted,keyboard,allowResume);application.processEvents();QThread::msleep(1);}
+        require(keys==2,"input sent to paused device");
+        eis_device_remove(keyboard);
+        elapsed.restart();while (elapsed.elapsed()<50) {dispatch(server,keys,accepted,keyboard,allowResume);application.processEvents();QThread::msleep(1);}
+        sender.sendEvent(press,QSize(1920,1080),QStringLiteral("fixture"));sender.sendEvent(release,QSize(1920,1080),QStringLiteral("fixture"));
+        elapsed.restart();while (elapsed.elapsed()<50) {dispatch(server,keys,accepted,keyboard,allowResume);application.processEvents();QThread::msleep(1);}
+        require(keys==2,"input sent to removed device");
+        require(accepted!=nullptr,"accepted client not retained");eis_client_disconnect(accepted);
+        elapsed.restart();while (errors==0 && elapsed.elapsed()<3000) {dispatch(server,keys,accepted,keyboard,allowResume);application.processEvents();QThread::msleep(1);}
+        require(errors==1 && !sender.isConnected(),"EIS disconnect did not revoke readiness");
+        sender.sendEvent(press,QSize(1920,1080),QStringLiteral("fixture"));sender.sendEvent(release,QSize(1920,1080),QStringLiteral("fixture"));
+        elapsed.restart();while (elapsed.elapsed()<50) {dispatch(server,keys,accepted,keyboard,allowResume);application.processEvents();QThread::msleep(1);}
+        require(keys==2,"input sent after EIS disconnect");
+    }
+    if (keyboard) eis_device_unref(keyboard);
+    if (accepted) eis_client_unref(accepted);
+    eis_unref(server);
+    std::cout << "real private libei/libeis FD handshake and key press/release passed\n";
+}
diff --git a/server/InheritedListenerTest.cpp b/server/InheritedListenerTest.cpp
new file mode 100644
index 0000000..4f4daa3
--- /dev/null
+++ b/server/InheritedListenerTest.cpp
@@ -0,0 +1,141 @@
+// SPDX-FileCopyrightText: 2026 enzUI contributors
+// SPDX-License-Identifier: MIT
+#include "../src/InheritedListener.h"
+#include "../src/Server.h"
+
+#include <cerrno>
+#include <cstdlib>
+#include <iostream>
+#include <vector>
+#include <sys/stat.h>
+
+#include <QCoreApplication>
+#include <QTcpSocket>
+
+namespace
+{
+void require(bool value, const char *message)
+{
+    if (!value) {
+        std::cerr << message << '\n';
+        std::exit(1);
+    }
+}
+
+int listener()
+{
+    int fd = socket(AF_INET, SOCK_STREAM | SOCK_CLOEXEC, IPPROTO_TCP);
+    require(fd >= 3, "fixture socket creation failed");
+    sockaddr_in address{};
+    address.sin_family = AF_INET;
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    require(bind(fd, reinterpret_cast<sockaddr *>(&address), sizeof(address)) == 0, "fixture bind failed");
+    require(listen(fd, 16) == 0, "fixture listen failed");
+    return fd;
+}
+
+quint16 port(int fd)
+{
+    sockaddr_in address{};
+    socklen_t size = sizeof(address);
+    require(getsockname(fd, reinterpret_cast<sockaddr *>(&address), &size) == 0, "fixture address unavailable");
+    return ntohs(address.sin_port);
+}
+
+void busy(quint16 number)
+{
+    int rival = socket(AF_INET, SOCK_STREAM | SOCK_CLOEXEC, IPPROTO_TCP);
+    require(rival >= 3, "rival creation failed");
+    sockaddr_in address{};
+    address.sin_family = AF_INET;
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    address.sin_port = htons(number);
+    require(bind(rival, reinterpret_cast<sockaddr *>(&address), sizeof(address)) == -1 && errno == EADDRINUSE, "reservation lost exclusivity");
+    close(rival);
+}
+}
+
+class AdmissionServer : public KRdp::Server {
+public:
+    using KRdp::Server::incomingConnection;
+};
+
+int main(int argc, char **argv)
+{
+    const char *hostNamespace = std::getenv("ENZIMOS_TEST_HOST_NETNS");
+    struct stat currentNamespace{};
+    require(hostNamespace != nullptr && stat("/proc/self/ns/net", &currentNamespace) == 0
+        && currentNamespace.st_ino != std::strtoull(hostNamespace, nullptr, 10), "private network namespace required; no host listener test");
+    QCoreApplication application(argc, argv);
+    int original = listener();
+    quint16 number = port(original);
+    require(number >= 1024, "fixture ephemeral port outside contract");
+    const QHostAddress address(QHostAddress::LocalHost);
+    require(EnzimOS::listenerMatches(original, address, number), "reserved listener rejected");
+    require(!EnzimOS::listenerMatches(original, address, number == 65535 ? 65534 : number + 1), "wrong port accepted");
+    require(!EnzimOS::listenerMatches(original, QHostAddress(QStringLiteral("127.0.0.2")), number), "wrong address accepted");
+    require(!EnzimOS::listenerMatches(original, QHostAddress::AnyIPv4, number), "wildcard accepted");
+    require(!EnzimOS::listenerMatches(1, address, number), "stdout accepted");
+    int pipeFds[2];
+    require(pipe2(pipeFds, O_CLOEXEC) == 0, "pipe fixture failed");
+    require(!EnzimOS::listenerMatches(pipeFds[0], address, number), "pipe accepted");
+    close(pipeFds[0]);close(pipeFds[1]);
+    int datagram = socket(AF_INET, SOCK_DGRAM | SOCK_CLOEXEC, IPPROTO_UDP);
+    require(datagram >= 3 && !EnzimOS::listenerMatches(datagram, address, number), "datagram accepted");
+    close(datagram);
+    int unbound = socket(AF_INET, SOCK_STREAM | SOCK_CLOEXEC, IPPROTO_TCP);
+    require(unbound >= 3 && !EnzimOS::listenerMatches(unbound, address, number), "nonlistener accepted");
+    close(unbound);
+    int reuse = 1;
+    require(setsockopt(original, SOL_SOCKET, SO_REUSEPORT, &reuse, sizeof(reuse)) == 0, "reuse fixture failed");
+    require(!EnzimOS::listenerMatches(original, address, number), "reusable listener accepted");
+    reuse = 0;
+    require(setsockopt(original, SOL_SOCKET, SO_REUSEPORT, &reuse, sizeof(reuse)) == 0, "exclusive reset failed");
+    {
+        QTcpServer server;
+        require(EnzimOS::adoptListener(server, original, address, number), "Qt listener adoption failed");
+        struct stat before{},after{};
+        require(fstat(original, &before) == 0 && fstat(server.socketDescriptor(), &after) == 0
+            && before.st_dev == after.st_dev && before.st_ino == after.st_ino, "Qt rebound instead of adopting");
+        require((fcntl(server.socketDescriptor(), F_GETFD) & FD_CLOEXEC) != 0, "Qt descriptor can escape exec");
+        require(!EnzimOS::adoptListener(server, original, address, number), "live listener replaced");
+        busy(number);
+        server.close();
+        require(fcntl(original, F_GETFD) >= 0, "Qt closed the borrowed reservation");
+        busy(number);
+    }
+    {
+        KRdp::Server server;
+        server.setAddress(address);server.setPort(number);
+        require(server.setReservedListener(original), "server reservation rejected");
+        require(!server.setReservedListener(original), "server reservation replaced");
+    }
+    busy(number);
+    {
+        AdmissionServer server;
+        server.setProtectedSharing(true);
+        require(!server.start(), "protected server rebound without reservation");
+        std::vector<int> clients, peers;
+        int admitted = 0;
+        QObject::connect(&server, &KRdp::Server::newConnectionCreated, &server, [&](auto *) { ++admitted; });
+        for (int i=0;i<5;++i) {
+            const int client = socket(AF_INET,SOCK_STREAM|SOCK_CLOEXEC,IPPROTO_TCP);
+            require(client>=3,"peer client fixture failed");
+            sockaddr_in target{}; target.sin_family=AF_INET;target.sin_addr.s_addr=htonl(INADDR_LOOPBACK);target.sin_port=htons(number);
+            require(connect(client,reinterpret_cast<sockaddr *>(&target),sizeof(target))==0,"private peer connection failed");
+            const int peer=accept4(original,nullptr,nullptr,SOCK_CLOEXEC);
+            require(peer>=3,"private peer accept failed");
+            clients.push_back(client);peers.push_back(peer);
+            server.incomingConnection(peer);
+        }
+        require(admitted==4,"protected pending peer capacity not enforced");
+        require(fcntl(peers.back(),F_GETFD)==-1 && errno==EBADF,"excess peer socket leaked");
+        server.stop();
+        for (int i=0;i<4;++i) require(fcntl(peers[i],F_GETFD)==-1 && errno==EBADF,"pre-initialize peer socket leaked during stop");
+        for(int client:clients) close(client);
+        require(!server.start(),"protected failed start was retried after stop");
